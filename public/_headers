# Response headers (Cloudflare static assets: free). A request takes the headers of every rule it matches.

# Every response: HTTPS only for 6 months (HSTS), no MIME sniffing, the origin only as the referrer to other sites, and no
# framing by other sites. HSTS is set here and only here: never also in the Cloudflare dashboard. Add includeSubDomains
# and preload only once http:// and www both answer 301 to https://useobsession.com (docs/SEARCH.md 8A).
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files carry a hash of their contents in their names, so they never change: cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Share images, logos and the report captures keep their names when they change: cached for a day.
/og/*
  Cache-Control: public, max-age=86400
/logo/*
  Cache-Control: public, max-age=86400
/report/*
  Cache-Control: public, max-age=86400

# Each app screen's HTML, fetched by a page reached client side (components/screens.ts): parts of pages, never pages.
/screens/*
  X-Robots-Tag: noindex

# The plain text guides for AI assistants, read as UTF-8 (their copy uses curly quotes).
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

# The IndexNow key (scripts/indexnow.mjs): plain text, and never a search result of its own.
/410ab3f4aed7c67c838e45b3f8336e44.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
