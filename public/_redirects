# Old addresses, sent for good to the pages that replaced them (Cloudflare static assets: free, run before any page).
# A path with and without its trailing slash are 2 rules. Prerendered pages answer /PATH with a 200; the host would send
# /PATH/ to /PATH with a temporary 307, so the slashed addresses the old site had indexed get a permanent 301 below.

/recipes/prospect-research    /recipes/prospect-intelligence  301
/recipes/prospect-research/   /recipes/prospect-intelligence  301
/recipes/speed-to-lead        /recipes/lead-leaks             301
/recipes/speed-to-lead/       /recipes/lead-leaks             301
/sample-report                /sample-output                  301
/sample-report/               /sample-output                  301
/templates                    /recipes                        301
/templates/                   /recipes                        301
/templates/prospect-research  /recipes/prospect-intelligence  301
/templates/speed-to-lead      /recipes/lead-leaks             301
/templates/*                  /recipes/:splat                 301

